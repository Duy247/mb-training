<idea-plugin>
    <id>com.mb.training.engine</id>
    <name>MBTraining Engine Framework</name>
    <vendor email="support@mb-training.com">MB Training</vendor>
    <description>
        Core training engine framework for interactive learning packs.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <extensionPoints>
        <extensionPoint
                name="trainingPackProvider"
                interface="com.mb.training.karate.packs.TrainingPackProvider"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.mb.training.karate.startup.OnboardingStartupActivity"/>
        <applicationConfigurable
                id="mb.training.engine.settings"
                displayName="MBTraining Engine"
                parentId="tools"
                instance="com.mb.training.karate.settings.TrainingEngineConfigurable"/>
        <toolWindow
                id="MB Training"
                anchor="right"
                factoryClass="com.mb.training.karate.ui.TrainingToolWindowFactory"
                canCloseContents="false"/>
    </extensions>

    <actions>
        <action
                id="com.mb.training.karate.OpenTrainingAction"
                class="com.mb.training.karate.actions.OpenTrainingAction"
                text="Open MBTraining Engine"
                description="Open MBTraining Engine tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
